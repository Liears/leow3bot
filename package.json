{
  "name": "@leow3lab/leow3bot",
  "version": "0.1.0",
  "description": "leow3bot — CLI AI agent (TypeScript + ink)",
  "type": "module",
  "bin": {
    "leow3bot": "./dist/main.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuanhechen/leow3bot.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "config.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/main.tsx",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "probe": "tsx src/scripts/probe.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "tsx tests/e2e/run-e2e.ts",
    "test": "tsc --noEmit && vitest run && npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.50.1",
    "gray-matter": "^4.0.3",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "sharp": "^0.33.5",
    "strip-ansi": "^7.2.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/turndown": "^5.0.6",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "keywords": [
    "cli",
    "ai-agent",
    "terminal",
    "tui",
    "ink",
    "react",
    "glm",
    "zhipu",
    "bigmodel",
    "anthropic",
    "chatbot",
    "coding-assistant"
  ]
}
